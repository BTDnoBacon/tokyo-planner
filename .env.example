# Google Maps JavaScript API (클라이언트 사이드)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# OpenWeatherMap (Server Action)
OPENWEATHER_API_KEY=

# ExchangeRate-API (Server Action)
EXCHANGERATE_API_KEY=

# Google Directions API (Server Action — 도보/택시 시간. 앱 제한 없음, Routes API 허용)
GOOGLE_DIRECTIONS_API_KEY=

# 전철 경로는 API 키 불필요 — 자체 엔진 (pnpm data:build로 시간표 생성)
